# ==================== DOC AI .env.example ====================

# === SECURITY (MUST CHANGE IN PRODUCTION!) ===
# Generate using: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=9e3b7c5c48b414755638bc418b892035b1f1ec93f1e2a2b4e49b2f9e1f22c248eb1a6765388ca0ac06f07580fea46bcce8bed593cf0272c30d78ad03f1a92492
JWT_SECRET_KEY=9e3b7c5c48b414755638bc418b892035b1f1ec93f1e2a2b4e49b2f9e1f22c248eb1a6765388ca0ac06f07580fea46bcce8bed593cf0272c30d78ad03f1a92492

# === Database ===
SQLALCHEMY_DATABASE_URI=sqlite:///doc_ai.db

# Production PostgreSQL (uncomment & update when deploying)
# SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://username:password@hostname:5432/doc_ai

SQLALCHEMY_TRACK_MODIFICATIONS=False

# CORS
CORS_ORIGINS=http://localhost:5173

# Account Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Redis (for production rate limiting & caching)
# REDIS_URL=redis://localhost:6379/0

# === File Uploads ===
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216        # 16MB

# === Google Places API (Optional) ===
# Leave empty during development. Get key later from Google Cloud Console.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# === Logging ===
LOG_LEVEL=INFO
LOG_DIR=logs

# === Rate Limiting ===
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100/60

# === Input Validation ===
MIN_PASSWORD_LENGTH=8
MAX_PASSWORD_LENGTH=128
MAX_STRING_LENGTH=1000

# === Model Paths ===
TEXT_MODEL_PATH=app/ml/text_model.joblib
IMAGE_MODEL_PATH=app/ml/image_model.h5

# === Development Settings ===
FLASK_ENV=development
FLASK_DEBUG=True

# === Production Settings (Uncomment when deploying on Render/Vercel) ===
# FLASK_ENV=production
# FLASK_DEBUG=False